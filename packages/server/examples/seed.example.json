{
  "sources": [
    {
      "id": "remote-example",
      "name": "远程订阅（示例，需改成真实地址）",
      "url": "https://[YOUR-SUBSCRIPTION-URL]",
      "pipeline": [
        { "op": "filter.useless" },
        { "op": "rename.regex", "rules": [{ "pattern": "^香港\\s*(\\d+).*$", "replace": "HK-$1" }, { "pattern": "^日本\\s*(\\d+).*$", "replace": "JP-$1" }, { "pattern": "^摩尔多瓦\\s*(\\d+).*$", "replace": "MD-$1" }] },
        { "op": "flag", "mode": "add" }
      ]
    }
  ],
  "locals": [
    {
      "id": "demo-a",
      "name": "演示节点",
      "proxies": [
        { "name": "🇭🇰 HK-01", "type": "trojan", "server": "hk.example.com", "port": 443, "password": "demo" },
        { "name": "🇯🇵 JP-03", "type": "trojan", "server": "jp.example.com", "port": 443, "password": "demo" }
      ]
    }
  ],
  "rulesets": [
    { "id": "ai", "name": "AI 服务", "note": "本地定制示例；模板中以本地前缀显示，可与 GitHub 规则集平级引用；可添加 USER-AGENT,ChatGPT*，仅 Surge 输出，mihomo 保留为不支持注释", "sources": [
      { "id": "main", "name": "常用 AI", "kind": "local", "format": "auto", "content": ".openai.com\n.anthropic.com\n.claude.ai\n" },
      { "id": "extra", "name": "补充", "kind": "local", "format": "classical", "content": "DOMAIN-SUFFIX,perplexity.ai\nDOMAIN-SUFFIX,claude.ai\n" }
    ], "overrides": [
      { "match": "DOMAIN-SUFFIX,perplexity.ai", "override": { "when": { "client": "surge", "platform": "ios" }, "action": { "replace": [{ "type": "RAW", "text": "DOMAIN-SUFFIX,perplexity.ai" }] } } }
    ] }
  ],
  "presets": [
    {
      "id": "fakeip",
      "name": "fake-ip 推荐",
      "version": 1,
      "stash": { "mode": "rule", "log-level": "warning", "dns": { "nameserver": ["https://doh.pub/dns-query"] } },
      "mihomo": {
        "mixed-port": 7890,
        "mode": "rule",
        "log-level": "warning",
        "find-process-mode": "strict",
        "dns": { "enable": true, "enhanced-mode": "fake-ip", "fake-ip-range": "198.18.0.1/16", "nameserver": ["https://doh.pub/dns-query"] }
      }
    }
  ],
  "templates": [
    {
      "id": "std",
      "name": "标准分流",
      "groups": [
        { "id": "sel", "name": "🚀 节点选择", "type": "select", "members": [{ "kind": "group", "groupId": "hk" }, { "kind": "builtin", "name": "DIRECT" }] },
        { "id": "hk", "name": "🇭🇰 香港", "type": "url-test", "members": [], "test": { "url": "https://www.gstatic.com/generate_204", "interval": 300 } },
        { "id": "ai", "name": "🤖 AI 服务", "type": "select", "members": [] }
      ],
      "rules": [
        { "id": "r-direct", "matcher": { "kind": "rule", "rule": { "type": "DOMAIN-SUFFIX", "value": "example.test" } }, "target": { "kind": "builtin", "name": "DIRECT" } },
        { "id": "r-ai", "matcher": { "kind": "ruleset", "id": "ai" }, "target": { "kind": "group", "groupId": "ai" } }
      ],
      "final": { "kind": "group", "groupId": "sel" }
    }
  ],
  "profiles": [
    {
      "id": "demo",
      "name": "演示订阅",
      "base": {
        "presetId": "fakeip"
      },
      "nodeSets": [
        {
          "ref": {
            "type": "local",
            "id": "demo-a"
          },
          "output": "provider"
        }
      ],
      "overlay": {},
      "chains": [],
      "refPolicy": {
        "default": "wrap"
      },
      "routing": {
        "mode": "independent",
        "config": {
          "groups": [
            {
              "id": "sel",
              "name": "🚀 节点选择",
              "type": "select",
              "members": [
                {
                  "kind": "group",
                  "groupId": "hk"
                },
                {
                  "kind": "builtin",
                  "name": "DIRECT"
                }
              ]
            },
            {
              "id": "hk",
              "name": "🇭🇰 香港",
              "type": "url-test",
              "members": [
                {
                  "kind": "nodeset",
                  "ref": {
                    "type": "local",
                    "id": "demo-a"
                  }
                }
              ],
              "test": {
                "url": "https://www.gstatic.com/generate_204",
                "interval": 300
              },
              "filter": "HK"
            },
            {
              "id": "ai",
              "name": "🤖 AI 服务",
              "type": "select",
              "members": []
            }
          ],
          "rules": [
            {
              "id": "r-direct",
              "matcher": {
                "kind": "rule",
                "rule": {
                  "type": "DOMAIN-SUFFIX",
                  "value": "example.test"
                }
              },
              "target": {
                "kind": "builtin",
                "name": "DIRECT"
              }
            },
            {
              "id": "r-ai",
              "matcher": {
                "kind": "ruleset",
                "id": "ai"
              },
              "target": {
                "kind": "group",
                "groupId": "ai"
              }
            }
          ],
          "final": {
            "kind": "group",
            "groupId": "sel"
          }
        },
        "initializedFrom": {
          "templateId": "std",
          "name": "标准分流"
        }
      }
    },
    {
      "id": "demo-bound",
      "name": "绑定模板演示",
      "base": {
        "presetId": "fakeip"
      },
      "nodeSets": [
        {
          "ref": {
            "type": "local",
            "id": "demo-a"
          },
          "output": "provider"
        }
      ],
      "overlay": {},
      "chains": [],
      "refPolicy": {
        "default": "wrap"
      },
      "routing": {
        "mode": "bound",
        "templateId": "std",
        "prependRules": [{ "id": "pre-direct", "matcher": { "kind": "rule", "rule": { "type": "DOMAIN", "value": "priority.example.test" } }, "target": { "kind": "builtin", "name": "DIRECT" } }],
        "groupAdditions": {
          "hk": [
            {
              "kind": "nodeset",
              "ref": {
                "type": "local",
                "id": "demo-a"
              }
            }
          ]
        }
      }
    }
  ],
  "tokens": [{"token": "demo-token", "profileId": "demo", "label": "演示"}, {"token": "demo-bound-token", "profileId": "demo-bound", "label": "绑定模板演示"}]
}
