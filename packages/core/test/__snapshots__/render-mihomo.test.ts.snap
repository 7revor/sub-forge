// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`校验 > 同一输入输出完全相同（快照） 1`] = `
"proxies:
  - name: 自建 SG-01
    type: trojan
    server: sg
    port: 443
    password: p
proxy-providers:
  落地:
    type: http
    url: https://sub.example.com/p/TOKEN/source%3AL?v=0e66dd5c
    interval: 3600
    proxy: DIRECT
    override:
      dialer-proxy: 🇭🇰 香港
  中转:
    type: http
    url: https://sub.example.com/p/TOKEN/source%3AT?v=b6f49804
    interval: 3600
    proxy: DIRECT
proxy-groups:
  - name: 🚀 节点选择
    type: select
    proxies:
      - 🇭🇰 香港
      - DIRECT
    empty-fallback: REJECT
  - name: 🇭🇰 香港
    type: url-test
    use:
      - 中转
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
    empty-fallback: REJECT
  - name: 🤖 AI 服务
    type: select
    proxies:
      - REJECT
    empty-fallback: REJECT
  - name: 📺 国内媒体
    type: select
    proxies:
      - REJECT
    empty-fallback: REJECT
rule-providers:
  rs_fin_classical:
    type: http
    behavior: classical
    format: text
    url: https://sub.example.com/r/TOKEN/rs_fin_classical.list
    interval: 86400
    proxy: DIRECT
  rs_ai_classical:
    type: http
    behavior: classical
    format: text
    url: https://sub.example.com/r/TOKEN/rs_ai_classical.list
    interval: 86400
    proxy: DIRECT
rules:
  - RULE-SET,rs_fin_classical,🚀 节点选择
  - RULE-SET,rs_ai_classical,🤖 AI 服务
  - PROCESS-PATH-WILDCARD,/Applications/*/WeChat.app/*,DIRECT
  - GEOIP,CN,DIRECT,no-resolve
  - MATCH,🚀 节点选择
"
`;
