# 复制为 docker/.env 后填写；该文件含密码，不要提交。
# 对外 HTTPS 地址：决定订阅链接与 Secure Cookie
PUBLIC_URL=https://sub.example.com
# 必填。允许写操作的浏览器来源，逗号分隔，不带路径；未配置时登录和所有写操作都会被拒绝
ALLOWED_ORIGINS=https://sub.example.com
# 应用发布到宿主机回环地址的端口，Nginx 的 upstream 与它一致
SUBFORGE_PORT=8080
# 可信代理的精确 IP / CIDR。首次留空，从访问日志的“连接来源”读到 Nginx 地址后再填写
SUBFORGE_TRUSTED_PROXIES=
# 仅首次启动且没有用户时使用，创建管理员后可以删除
SUBFORGE_ADMIN_USERNAME=admin
SUBFORGE_ADMIN_PASSWORD=

# 缓存周期按此时区的 0 点对齐；默认 UTC
TZ=UTC
